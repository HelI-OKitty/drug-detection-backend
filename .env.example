MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
JWT_SECRET=<32바이트 랜덤 문자열 ex. openssl rand -hex 32>
DB_NAME=drug_db
CORS_ORIGINS=["http://localhost:3000"]
TEXT_AI_URL=https://<Cloudflare 터널 주소 또는 AI 서버 IP:포트>
TEXT_AI_API_KEY=<텍스트 AI API 키>
IMAGE_AI_URL=https://<Cloudflare 터널 주소 또는 AI 서버 IP:포트>
IMAGE_AI_API_KEY=<이미지 AI API 키>
